generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  ORGANIZATION_OWNER
  ORGANIZATION_ADMIN
  TEACHER
  STUDENT
  INDIVIDUAL_LEARNER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Unified identity. Membership + role defines a user's access within each
/// organization; a user may belong to any number of organizations.
model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  emailVerified          Boolean   @default(false)
  image                  String?
  isPlatformAdmin        Boolean   @default(false)
  currentOrganizationId  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships       OrganizationMember[]
  invitedBy         Invitation[]           @relation("Inviter")
  invitee           Invitation[]           @relation("Invitee")
  auditLogs         AuditLog[]             @relation("Actor")
  sessions          Session[]
  accounts          Account[]
  coursesCreated    Course[]
  classesTaught     Class[]                @relation("ClassTeacher")
  enrollments       ClassEnrollment[]
  assignedAssignments ClassAssignment[]   @relation("AssignmentAuthor")
  assignmentSubmissions AssignmentSubmission[]
  learnerProfiles   LearnerProfile[]
  activityEventsAsActor  ActivityEvent[]   @relation("ActivityActor")
  activityEventsAsStudent ActivityEvent[]  @relation("ActivityStudent")
  notificationsRecipient Notification[]    @relation("NotificationRecipient")
  notificationsAsActor    Notification[]    @relation("NotificationActor")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  courses     Course[]
  classes     Class[]
  learnerProfiles LearnerProfile[]
  activityEvents ActivityEvent[]
  notifications  Notification[]

  @@map("organization")
}

/// A user's role inside a single organization. Tenant isolation is enforced
/// server-side by resolving membership from the authenticated user id —
/// never from client-supplied values.
model OrganizationMember {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_member")
}

model Invitation {
  id           String           @id @default(cuid())
  orgId        String
  email        String
  role         Role
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String
  inviteeUserId String?
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())

  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User          @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)
  invitee   User?         @relation("Invitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([email])
  @@map("invitation")
}

/// Append-only record of organization-sensitive actions.
model AuditLog {
  id         String    @id @default(cuid())
  orgId      String?
  actorId    String?
  action     String
  targetType String
  targetId   String?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("audit_log")
}

/// A subject-agnostic learning course owned by an organization.
model Course {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  subject     String
  description String?
  level       String?
  color       String?
  published   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  topics    CourseTopic[]
  classes   Class[]
  activityEvents ActivityEvent[]

  @@index([orgId, subject])
  @@map("course")
}

model CourseTopic {
  id          String   @id @default(cuid())
  courseId    String
  order       Int      @default(0)
  title       String
  description String?
  createdAt   DateTime @default(now())

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId, order])
  @@map("course_topic")
}

/// A single learning unit. `content` is a structured JSON payload consumed by
/// the lesson renderer (kept generic so any subject can be taught).
model CourseLesson {
  id        String   @id @default(cuid())
  topicId   String
  order     Int      @default(0)
  title     String
  kind      String
  minutes   Int?
  content   Json?
  createdAt DateTime @default(now())

  topic CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  assignments ClassAssignment[]
  activityEvents ActivityEvent[]

  @@index([topicId, order])
  @@map("course_lesson")
}

/// A teacher-led group of students studying a course within an organization.
model Class {
  id          String   @id @default(cuid())
  orgId       String
  courseId    String
  teacherId   String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User?              @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments ClassEnrollment[]
  assignments ClassAssignment[]
  activityEvents ActivityEvent[]

  @@index([orgId])
  @@map("class")
}

model ClassEnrollment {
  id         String   @id @default(cuid())
  classId    String
  studentId  String
  enrolledAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_enrollment")
}

/// A lesson assigned by a teacher to a whole class, with a due date.
model ClassAssignment {
  id           String   @id @default(cuid())
  classId      String
  lessonId     String
  assignedById String?
  dueAt        DateTime
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class      Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson     CourseLesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assignedBy User?                 @relation("AssignmentAuthor", fields: [assignedById], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([classId])
  @@index([lessonId])
  @@map("class_assignment")
}

/// One student's completion of an assignment.
model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  completedAt  DateTime @default(now())

  assignment ClassAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submission")
}

// ─── Activity feed & notifications (Phase 11) ──────────────────────────────
// Org-wide timeline of notable events. Personal notifications are derived
// from events and target specific members; both are best-effort records.

/// One entry in the org-wide activity feed.
model ActivityEvent {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?
  type      String
  classId   String?
  courseId  String?
  lessonId  String?
  studentId String?
  summary   String
  createdAt DateTime @default(now())

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor   User?         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  class   Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  course  Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User?         @relation("ActivityStudent", fields: [studentId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([orgId, createdAt])
  @@index([classId])
  @@map("activity_event")
}

/// A per-recipient notification derived from an activity event.
model Notification {
  id          String         @id @default(cuid())
  orgId       String
  recipientId String
  actorId     String?
  eventId     String?
  type        String
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime       @default(now())

  org       Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipient User?          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  event     ActivityEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([orgId, createdAt])
  @@map("notification")
}

// ─── Study engine (Phase 3) ────────────────────────────────────────────────
// Per-learner study state, scoped to (orgId, userId) and therefore tenant-
// isolated. The client store keeps its existing interface and pushes/reads a
// full `StudyState` slice; the catalog content (grammar topics, comprehension
// items, prompts, mock exam templates) stays deterministic client-side.

/// One learner's profile inside one organization (the demo shell's UserProfile).
model LearnerProfile {
  id                String   @id @default(cuid())
  orgId             String
  userId            String
  currentLevel      String
  targetLevel       String
  examType          String
  examDate          String?
  dailyStudyMinutes Int      @default(30)
  strengths         Json?
  weaknesses        Json?
  targetAusbildung  String?
  itField           String?
  preferredRegions  Json?
  onboarded         Boolean  @default(false)
  timezone          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary       VocabularyEntry[]
  skills           SkillProgress[]
  plan             StudyPlan?
  tasks            StudyTask[]
  sessions         StudySessionRow[]
  mockResults      MockExamResultRow[]
  mistakes         MistakeRow[]
  achievements     AchievementRow[]
  speakingSessions SpeakingSessionRow[]
  settings         LearnerSettings?

  @@unique([orgId, userId])
  @@index([userId])
  @@map("learner_profile")
}

/// A learner's vocabulary entry (SRS state + word snapshot). Keyed by `german`
/// so progress stays consistent across devices even when local word ids differ.
model VocabularyEntry {
  id              String    @id @default(cuid())
  learnerId       String
  wordId          String
  german          String
  article         String
  plural          String?
  english         String
  ipa             String?
  example         String
  exampleEnglish  String?
  category        String
  difficulty      Int       @default(1)
  familiarity     Float     @default(0)
  ease            Float     @default(2.5)
  interval        Int       @default(0)
  reviews         Int       @default(0)
  dueAt           DateTime
  lastReviewedAt  DateTime?
  createdAt       DateTime
  mastered        Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, german])
  @@index([learnerId, dueAt])
  @@map("vocabulary_entry")
}

/// Per-skill progress totals used by the engine (scores, minutes, lessons).
model SkillProgress {
  id               String    @id @default(cuid())
  learnerId        String
  skill            String
  score            Int       @default(0)
  previousScore    Int       @default(0)
  lessonsCompleted Int       @default(0)
  practiceMinutes  Int       @default(0)
  lastPracticedAt  DateTime?
  updatedAt        DateTime  @updatedAt

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, skill])
  @@map("skill_progress")
}

/// The adaptive study plan. `phases` and `adjustments` are stored as JSON.
model StudyPlan {
  id             String   @id @default(cuid())
  learnerId      String   @unique
  generatedAt    DateTime
  lastAdaptedAt  DateTime
  examDate       String
  phases         Json
  adjustments    Json

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("study_plan")
}

/// A single day's study task from the plan.
model StudyTask {
  id            String  @id
  learnerId     String
  date          String
  skill         String
  title         String
  description   String?
  durationMinutes Int
  difficulty    Int
  status        String
  type          String
  sourceId      String?
  phaseId       String?
  completedAt   String?
  isRest        Boolean @default(false)
  isPlaceholder Boolean @default(false)

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, date])
  @@map("study_task")
}

/// A completed practice session.
model StudySessionRow {
  id              String  @id
  learnerId       String
  taskId          String?
  skill           String
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int
  source          String?
  score           Int?
  completed       Boolean @default(true)

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@map("study_session")
}

/// A submitted mock exam result. Snapshot arrays are stored as JSON.
model MockExamResultRow {
  id              String    @id
  learnerId       String
  templateId      String
  name            String
  level           String
  date            DateTime
  durationMinutes Int
  sectionScores   Json
  totalScore      Int
  totalMaxScore   Int
  percent         Float
  answers         Json
  mistakes        Json
  weakTopics      Json

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@map("mock_exam_result")
}

/// Mistake bank entry (spelling, articles, verbs, cases, word order, skills…).
model MistakeRow {
  id           String   @id
  learnerId    String
  category     String
  subcategory  String?
  original     String
  correct      String
  reason       String
  relatedTopic String?
  createdAt    DateTime
  reviewDate   String
  reviewed     Boolean  @default(false)
  timesCorrect Int      @default(0)

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@map("mistake")
}

/// Gamification achievement progress for a learner.
model AchievementRow {
  id          String  @id @default(cuid())
  learnerId   String
  key         String
  title       String
  description String
  icon        String
  unlockedAt  String?
  progress    Float   @default(0)
  target      Float   @default(0)

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, key])
  @@map("achievement")
}

/// A recorded speaking practice session. Audio recordings stay device-local.
model SpeakingSessionRow {
  id              String   @id
  learnerId       String
  promptId        String
  level           String
  date            DateTime
  answers         Json
  feedback        Json
  durationMinutes Int

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@map("speaking_session")
}

/// Learner preferences (theme, sound, exam mode, rest-day cadence…).
model LearnerSettings {
  id             String  @id @default(cuid())
  learnerId      String  @unique
  theme          String  @default("system")
  sound          Boolean @default(true)
  examMode       Boolean @default(false)
  restDayEvery   Int     @default(7)
  notifications  Boolean @default(true)

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("learner_settings")
}
