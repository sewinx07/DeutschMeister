# --- Database ---
# PostgreSQL connection string (Neon). Used by Prisma migrations and the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional — used by the tenant-isolation test suite (points at a dedicated
# Neon branch so tests never touch the development database).
TEST_DATABASE_URL=

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-64-char-hex-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional AI (used by the demo app's coach/writing/speaking analyzers) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o-mini
